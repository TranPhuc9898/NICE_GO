{
  "name": "CarBooking",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean": "rm -rf $TMPDIR/react-* && watchman watch-del-all && rm -rf node_modules ios/build android/build && yarn install",
    "reset": "rm -rf $TMPDIR/react-* && watchman watch-del-all && rm -rf node_modules && rm -rf ios/build && rm -rf ios/Pods && yarn install && cd ios && pod install && cd ../android && rm -rf app/build",
    "remove-cache": "watchman watch-del-all && rm -rf $TMPDIR/react-native-packager-cache-* && rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf ~/Library/Developer/Xcode/DerivedData && yarn start -- --reset-cache",
    "pod": "cd ios && pod install && cd .. && chmod +x ./fix-android-library.sh && sh ./fix-android-library.sh && chmod +x ./fix-ios-library.sh && sh ./fix-ios-library.sh",
    "fix-lib-android": "chmod +x ./fix-android-library.sh && sh ./fix-android-library.sh",
    "fix-lib-ios": "chmod +x ./fix-ios-library.sh && sh ./fix-ios-library.sh",
    "dev": "rm -rf node_modules && yarn && rm -rf ~/.rncache && yarn cache clean && rm -rf ios/Podfile.lock && rm -rf ios/Pods && rm -rf ios/CarBooking.xcworkspace && rm -rf ~/Library/Developer/Xcode/DerivedData/ && rm -rf ~/Library/Caches/CocoaPods/ && cd ios && pod install && pod update && cd .. && yarn start --reset-cache"
  },
  "dependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@gorhom/bottom-sheet": "^5",
    "@mapbox/polyline": "^1.2.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.6.2",
    "@react-native-firebase/messaging": "^21.6.2",
    "@react-navigation/bottom-tabs": "^7.1.3",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/material-top-tabs": "^7.1.0",
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/stack": "^7.0.18",
    "@reduxjs/toolkit": "^2.4.0",
    "@shopify/flash-list": "^1.7.2",
    "@tanstack/react-query": "^5.62.7",
    "@types/react-native": "^0.73.0",
    "add": "^2.0.6",
    "axios": "^1.12.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "date-fns": "^4.1.0",
    "decode-google-map-polyline": "^1.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-extra-rules": "^0.0.0-development",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "i18next": "^24.2.1",
    "lodash": "^4.17.21",
    "lottie-react-native": "^7.2.1",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.75.4",
    "react-native-config": "^1.5.3",
    "react-native-devsettings": "^1.0.5",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-image-picker": "^8.2.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.4.1",
    "react-native-maps": "^1.20.1",
    "react-native-pager-view": "^6.6.1",
    "react-native-permissions": "^5.2.1",
    "react-native-reanimated": "3.16.5",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.3.0",
    "react-native-snap-carousel": "4.0.0-beta.6",
    "react-native-svg": "^15.10.1",
    "react-native-toast-message": "^2.2.1",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@types/add": "^2",
    "@types/lodash": "^4",
    "@types/mapbox__polyline": "^1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.4.0",
  "reactNativePermissionsIOS": [
    "Camera",
    "Contacts",
    "FaceID",
    "LocationWhenInUse",
    "PhotoLibrary"
  ]
}
